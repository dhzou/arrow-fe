{
  "name": "arrow-fe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:wx": "node scripts/generate-wx-cover.mjs && vite build --config vite.config.wx.ts && vite build --config vite.config.wx-sub.ts && node scripts/copy-wx-assets.mjs",
    "build:mp": "vite build --config vite.config.mp.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "bake:snake-levels": "npx tsx scripts/bake-snake-levels.mts",
    "validate:snake-level": "npx tsx scripts/validate-snake-level.mts"
  },
  "dependencies": {
    "pinia": "^2.2.6",
    "pixi.js": "^8.6.6",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
